# ==========================================
# Telegram Bot & Google Sheets Configuration
# ==========================================

# 1. Telegram Bot Token from BotFather
# You can use TELEGRAM_BOT_TOKEN or BOT_TOKEN
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# BOT_TOKEN=your_telegram_bot_token_here

# 2. Google Service Account Credentials
# Option A (Local file): Place your downloaded credentials.json file in this folder
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Option B (Cloud hosting like Render/Railway/Heroku): Paste the minified JSON string directly
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# 3. Google Spreadsheet Configuration
# You can specify either the Sheet Name, the Spreadsheet ID, or both.
# Spreadsheet ID is recommended (found in the URL: /spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_NAME=Telegram Safe Records
GOOGLE_SHEET_ID=

# Worksheet (Tab) name inside the spreadsheet (default: SafeRecords)
GOOGLE_WORKSHEET_NAME=SafeRecords

# 4. Security & Access Control
# Comma-separated list of Telegram User IDs authorized to interact with the bot.
# Example: 123456789,987654321
# Tip: Send /start to the bot in Telegram; it will tell you your exact numeric User ID.
ALLOWED_TELEGRAM_USER_IDS=
